# Cadena de conexión de PostgreSQL. Vercel + Neon la crea sola.
# Si la dejas vacía en desarrollo, se usa PGlite en la carpeta .pglite.
DATABASE_URL=

# Firma de las sesiones. Genera una con: openssl rand -base64 48
AUTH_SECRET=

# Protege la tarea diaria (recordatorios y reinicio de la demo).
CRON_SECRET=

# Clave para entrar a /plataforma y ver las solicitudes de contacto.
PLATAFORMA_CLAVE=

# URL pública del sitio.
NEXT_PUBLIC_URL_SITIO=http://localhost:3000
